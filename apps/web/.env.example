# Oracle LLM (chat + insights)
# Default: if ANTHROPIC_API_KEY is unset, requests go to local Ollama at http://127.0.0.1:11434
# OLLAMA_MODEL=llama3.2
# OLLAMA_BASE_URL=http://127.0.0.1:11434
# OLLAMA_TEMPERATURE=0.35
# OLLAMA_NUM_PREDICT=2048

# Use Claude instead (set ORACLE_LLM=anthropic when both keys exist and you want Claude)
# ORACLE_LLM=anthropic
# ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=claude-3-5-sonnet-latest
# ANTHROPIC_TEMPERATURE=0.45
