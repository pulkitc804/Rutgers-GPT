# Oracle LLM (chat + insights)
# Default: if ANTHROPIC_API_KEY is unset, requests go to local Ollama at http://127.0.0.1:11434
#
# Recommended local model (pull once): ollama pull qwen2.5:7b-instruct
# OLLAMA_MODEL=qwen2.5:7b-instruct
# OLLAMA_BASE_URL=http://127.0.0.1:11434
# OLLAMA_TEMPERATURE=0.2
# OLLAMA_NUM_PREDICT=2048
# OLLAMA_NUM_CTX=8192
# OLLAMA_TOP_P=0.9
# OLLAMA_REPEAT_PENALTY=1.12
# OLLAMA_DIRECT_SCHEDULE=0
# OLLAMA_EMBED_MODEL=nomic-embed-text

# RAG corpus lives in apps/web/data/rutgers-corpus/*.md (keyword search; optional Ollama embeddings above)

# --- Groq — FREE tier brain (Llama 3.3 70B: smartest free option, higher limits, fast) ---
# Create a free key at https://console.groq.com/keys (no billing required).
# ORACLE_LLM=groq
# GROQ_API_KEY=gsk_...
# GROQ_MODEL=llama-3.3-70b-versatile
# GROQ_TEMPERATURE=0.4

# --- Google Gemini — FREE tier brain (recommended for a smart, $0 hosted model) ---
# Create a free key at https://aistudio.google.com/apikey (no billing required).
# Free tier ~1,500 requests/day on flash models.
# ORACLE_LLM=gemini
# GEMINI_API_KEY=AIza...
# GEMINI_MODEL=gemini-2.5-flash-lite     # default: higher free RPM + less overload than flash
#                                        # (use gemini-2.5-flash for higher quality on paid tier;
#                                        #  gemini-2.0-flash was deprecated 2026-06-01)
# GEMINI_TEMPERATURE=0.4

# --- Claude (Anthropic) — paid API; key stays on your machine/server only ---
# Create a key at https://console.anthropic.com/ (billing required; pay per token).
# ORACLE_LLM=anthropic
# ANTHROPIC_API_KEY=sk-ant-...
# ANTHROPIC_MODEL=claude-sonnet-4-20250514
# ANTHROPIC_TEMPERATURE=0.45
# Never commit .env.local or share your API key.
