{
  "name": "rutgers-gpt-monorepo",
  "private": true,
  "packageManager": "npm@10.8.2",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "clean": "npm run clean --workspace=@rutgers-gpt/web",
    "dev:web": "npm run dev --workspace=@rutgers-gpt/web",
    "build:web": "npm run build --workspace=@rutgers-gpt/web",
    "build": "turbo run build",
    "dev": "turbo run dev",
    "lint": "turbo run lint"
  },
  "devDependencies": {
    "turbo": "^2.3.3"
  }
}
